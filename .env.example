# Copy to .env.local for local development, and add both in Vercel -> Project -> Settings -> Environment Variables.
# Both values are public (Supabase -> Project Settings -> API). Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
